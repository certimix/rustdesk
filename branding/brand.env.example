# =============================================================================
# Zenydesk Client Rebranding Configuration Template
# Copy this file to brand.env and fill in your custom brand credentials.
# NOTE: brand.env is listed in .gitignore and must NEVER be committed to Git.
# =============================================================================

# Brand Identity
BRAND_NAME="Zenydesk"
BRAND_SLUG="zenydesk"
BRAND_DOMAIN="zenydesk.com"
BRAND_SUPPORT_EMAIL="suporte@zenydesk.com"

# Server Connection Defaults
# Phase 1 Validation (Public RustDesk Test Server):
# RENDEZVOUS_SERVER="rs-ny.rustdesk.com"
# RS_PUB_KEY="O38B2Bclaj9ODF2xBDviA5B/s26zmaAga9RyIdNd7hE="
# API_SERVER="https://api.zenydesk.com"

# Phase 2 Production (Your Self-Hosted Zenydesk VPS):
RENDEZVOUS_SERVER="api.zenydesk.com.br"
RS_PUB_KEY="YOUR_HOSTINGER_VPS_ED25519_PUBLIC_KEY_HERE"
API_SERVER="https://api.zenydesk.com.br"

# Platform Package Identifiers
ANDROID_PACKAGE_ID="com.zenydesk.client"
MACOS_BUNDLE_ID="com.zenydesk.client"
WINDOWS_SERVICE_NAME="ZenydeskService"
