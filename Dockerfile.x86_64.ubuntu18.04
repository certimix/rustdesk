FROM ubuntu:18.04

# Fix apt-get to use --fix-missing and add retry logic
RUN mkdir -p /root/.aptrc && echo 'APT::Retries "3";' >> /etc/apt/apt.conf.d/retry-config

# Update package lists with retries
RUN apt-get update || apt-get update || apt-get update

# Install dependencies with retry logic and --fix-missing
RUN apt-get install --fix-missing -y \
    build-essential \
    git \
    curl \
    wget \
    ca-certificates \
    gnupg \
    software-properties-common && \
    rm -rf /var/lib/apt/lists/*

# Install development dependencies
RUN apt-get update && apt-get install --fix-missing -y \
    nasm \
    yasm \
    libgtk-3-dev \
    clang \
    libxcb-randr0-dev \
    libxdo-dev \
    libxfixes-dev \
    libxcb-shape0-dev \
    libxcb-xfixes0-dev \
    libasound2-dev \
    libpulse-dev \
    libssl-dev \
    unzip \
    zip \
    sudo \
    ninja-build \
    pkg-config && \
    rm -rf /var/lib/apt/lists/*

# Install GStreamer with retry logic
RUN apt-get update && apt-get install --fix-missing -y \
    gstreamer1.0-plugins-base \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev || \
    apt-get install --fix-missing -y gstreamer1.0-plugins-base || \
    echo "Warning: Some GStreamer packages could not be installed" && \
    rm -rf /var/lib/apt/lists/*

# Install CMake
RUN wget https://github.com/Kitware/CMake/releases/download/v3.30.6/cmake-3.30.6.tar.gz --no-check-certificate && \
    tar xzf cmake-3.30.6.tar.gz && \
    cd cmake-3.30.6 && \
    ./configure --prefix=/usr/local && \
    make && \
    make install && \
    cd .. && \
    rm -rf cmake-3.30.6*

# Setup non-root user
RUN groupadd -r user && \
    useradd -r -g user user --home /home/user && \
    mkdir -p /home/user && \
    chown -R user:user /home/user && \
    echo "user ALL=(ALL) NOPASSWD:ALL" | tee /etc/sudoers.d/user

WORKDIR /home/user

USER user

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain none && \
    . $HOME/.cargo/env

USER root

ENV HOME=/home/user
ENV PATH="/home/user/.cargo/bin:${PATH}"

WORKDIR /home/user
